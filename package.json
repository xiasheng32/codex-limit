{
  "name": "codex-limit",
  "version": "0.2.1",
  "description": "Pi extension: 在页脚显示 Codex 订阅剩余额度与重置时间。",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "quota",
    "hud"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiasheng32/codex-limit.git"
  },
  "homepage": "https://github.com/xiasheng32/codex-limit#readme",
  "bugs": {
    "url": "https://github.com/xiasheng32/codex-limit/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/codex-limit.ts",
    "src/quota.ts",
    "scripts/sync-autoload.ts",
    "tests/codex-limit.test.ts",
    "tests/sync-autoload.test.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/codex-limit.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/codex-limit.test.ts tests/sync-autoload.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "sync-autoload": "node scripts/sync-autoload.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
