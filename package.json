{
  "name": "pi-codex",
  "version": "0.4.5",
  "description": "Pi extension: Codex 订阅额度、重置倒计时与会话内 Fast 模式。",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "quota",
    "hud"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiasheng32/pi-codex.git"
  },
  "homepage": "https://github.com/xiasheng32/pi-codex#readme",
  "bugs": {
    "url": "https://github.com/xiasheng32/pi-codex/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/index.ts",
    "src/quota.ts",
    "src/fast-mode.ts",
    "src/fast-catalog.ts",
    "src/fast-provider.ts",
    "scripts/sync-autoload.ts",
    "tsconfig.json",
    "README.md",
    "docs/README.en.md",
    "docs/CHANGELOG.md",
    "docs/CHANGELOG.en.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "sync-autoload": "node scripts/sync-autoload.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
